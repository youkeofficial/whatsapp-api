# Clé attendue dans le header x-api-key de chaque requête. Obligatoire en production
# (le service refuse de démarrer sans elle) ; générée automatiquement pour la session en dev
# si absente, avec un avertissement dans la console.
WHATSAPP_API_KEY=

# Port d'écoute HTTP du service.
PORT=3020

# development | production — en production, WHATSAPP_API_KEY doit être défini explicitement.
NODE_ENV=development

# silent | error | warn | info | debug | trace — niveau de log Baileys (pino).
LOG_LEVEL=warn

# Indicatif téléphonique par défaut (sans le +) pour le formatage des numéros locaux
DEFAULT_COUNTRY_CODE=224