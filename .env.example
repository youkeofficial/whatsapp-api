# ─── Service ──────────────────────────────────────────────────────────────────

# Port d'écoute HTTP du service.
PORT=3020

# development | production
NODE_ENV=development

# ─── Authentification ─────────────────────────────────────────────────────────

# Clé maître pour administrer les sessions via /admin/sessions
# Obligatoire en production — génère une valeur robuste :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_API_KEY=

# ─── Sessions WhatsApp ───────────────────────────────────────────────────────
# Chaque session dispose de sa propre clé API (générée via POST /admin/sessions).
# Aucune configuration statique par session dans ce fichier.

# ─── Webhook (optionnel) ──────────────────────────────────────────────────────
# URL de webhook globale par défaut (surchargeable par session via /admin/sessions)
DEFAULT_WEBHOOK_URL=

# ─── Logs Baileys ─────────────────────────────────────────────────────────────
# silent | error | warn | info | debug | trace
LOG_LEVEL=warn

# ─── Formats de numéros ───────────────────────────────────────────────────────
# Indicatif pays par défaut (sans le +) pour les numéros locaux
DEFAULT_COUNTRY_CODE=224